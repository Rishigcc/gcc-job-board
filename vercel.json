{
  "functions": {
    "api/public.js": {
      "includeFiles": "dist/app.html"
    }
  },
  "rewrites": [
    {
      "source": "/gcc-jobs/:slugId",
      "destination": "/api/public?page=job&slugId=:slugId"
    },
    {
      "source": "/sitemap-jobs.xml",
      "destination": "/api/public?page=sitemap-jobs"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "crons": [
    {
      "path": "/api/send-digest",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/rebuild",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/recruiter",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/recruiter/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
